// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---
enum UserRole {
  USER
  ADMIN
  MANAGER
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  COMPLETED
  CANCELED
}

enum AddressType {
  HOME
  OFFICE
}

// --- Models ---

// ===== Users =====
model User {
  id                       String    @id @default(uuid())
  email                    String    @unique
  password                 String
  firstName                String    @default("")
  lastName                 String    @default("")
  phone                    String?
  avatarUrl                String    @default("")
  role                     UserRole  @default(USER)
  isActive                 Boolean   @default(true)
  isEmailVerified          Boolean   @default(false)
  emailVerificationToken   String?
  emailVerificationExpires DateTime?
  resetPasswordToken       String?
  resetPasswordExpires     DateTime?
  password_changed_at      DateTime?
  addresses                Address[]
  orders                   Order[]
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([role])
  @@index([isActive])
  @@map("users")
}

// ===== Users =====

// ===== Addresses =====
model Address {
  id              String      @id @default(uuid())
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade) // onDelete: nghĩa là nếu user bị xoá thì các post con liên quan cũng bị xoá.
  userId          String
  nameReminiscent String
  firstName       String
  lastName        String
  phone           String
  province        String
  ward            String
  zipCode         String
  address         String
  fullAddress     String
  addressType     AddressType @default(HOME)
  isDefault       Boolean     @default(false)

  /**
   * Đơn hàng có thể tham chiếu địa chỉ này tại thời điểm tạo (snapshot)
   * Khi người dùng tạo đơn hàng, hệ thống lưu lại địa chỉ tại thời điểm đó
   * Người dùng có địa chỉ “123 Đống Đa, Hà Nội”.
   * Khi tạo đơn hàng, order đó sẽ lưu addressId trỏ về địa chỉ này.
   * Sau này người dùng sửa địa chỉ thành "456 Cầu Giấy", thì đơn hàng cũ vẫn trỏ về địa chỉ ban đầu, không bị đổi.
   */
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isDefault])
  @@map("addresses")
}

// ===== Addresses =====

// ===== Products =====
model Product {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  price       Decimal @db.Decimal(12, 2)
  stock       Int     @default(0)
  isPublished Boolean @default(false)

  // Foreign keys
  productTypeId String
  productType   ProductType      @relation(fields: [productTypeId], references: [id])
  dressStyleId  String
  dressStyle    DressStyle       @relation(fields: [dressStyleId], references: [id])
  colors        ProductColor[]
  sizes         ProductSize[]
  images        ProductImage[]
  orderItems    OrderItem[]
  variants      ProductVariant[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([productTypeId])
  @@index([dressStyleId])
  @@index([slug])
  @@index([isPublished])
  @@map("products")
}

model ProductVariant {
  id        String       @id @default(uuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorId   String
  color     ProductColor @relation(fields: [colorId], references: [id])
}

model ProductType {
  id        String    @id @default(uuid())
  name      String    @unique // "T-Shirts", "Shirts", "Jeans"me
  slug      String    @unique
  isActive  Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("product_types")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@map("categories")
}

model DressStyle {
  id        String    @id @default(uuid())
  name      String    @unique // "Casual", "Formal", "Party", "Gym"
  slug      String    @unique
  isActive  Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("dress_styles")
}

model ProductImage {
  id        String   @id @default(uuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  productId String
  url       String
  altText   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("product_images")
}

model Color {
  id        String         @id @default(uuid())
  name      String         @unique // "Black", "White", "Red"
  hex       String // "#000000"
  isActive  Boolean        @default(true)
  products  ProductColor[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("colors")
}

model Size {
  id        String        @id @default(uuid())
  name      String        @unique // "Small", "Medium", "Large"
  value     String        @unique // "s", "m", "l"
  isActive  Boolean       @default(true)
  products  ProductSize[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("sizes")
}

model ProductColor {
  id              String           @id @default(uuid())
  productId       String
  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorId         String
  color           Color            @relation(fields: [colorId], references: [id])
  image           String? // URL ảnh cho từng variant
  createdAt       DateTime         @default(now())
  productVariants ProductVariant[]

  @@unique([productId, colorId])
  @@index([productId])
  @@index([colorId])
  @@map("product_colors")
}

model ProductSize {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizeId    String
  size      Size     @relation(fields: [sizeId], references: [id])
  stock     Int      @default(0) // Stock riêng cho từng size
  createdAt DateTime @default(now())

  @@unique([productId, sizeId])
  @@index([productId])
  @@index([sizeId])
  @@map("product_sizes")
}

// ===== Products =====

// ===== Orders =====
model Order {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  userId String

  // Snapshot địa chỉ giao hàng tại thời điểm đặt (link tới Address hiện tại)
  // Nếu muốn “copy cứng” địa chỉ, có thể thêm các field text (shipName, shipLine1, ...) ở đây.
  shipping          Address? @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  shippingAddressId String?

  status OrderStatus @default(PENDING)
  // Tổng tiền được tính theo OrderItem.price * quantity, có thể lưu để chốt hóa đơn
  total  Decimal     @db.Decimal(14, 2)

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(uuid())
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  orderId String

  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  productId String

  // Giá tại thời điểm đặt hàng (snapshot), không phụ thuộc Product.price hiện tại
  price    Decimal @db.Decimal(12, 2)
  quantity Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, productId]) // tránh trùng sản phẩm trong 1 đơn
  @@index([productId])
  @@map("order_items")
}

// ===== Orders =====
