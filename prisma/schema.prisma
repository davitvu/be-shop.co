// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---
enum UserRole {
  USER
  ADMIN
  MANAGER

  @@map("user_role")
}

enum OrderStatus {
  PENDING // chờ xác nhận
  CONFIRMED // đã xác nhận
  PROCESSING // đang xử lý
  SHIPPING // đang giao hàng
  DELIVERED // đã giao hàng
  CANCELLED // đã hủy
  REFUNDED // đã hoàn tiền

  @@map("order_status")
}

enum PaymentMethod {
  COD
  VNPAY
  MOMO
  STRIPE
  PAYPAL

  @@map("payment_method")
}

enum PaymentStatus {
  PENDING // chờ thanh toán
  PAID // dã thanh toán
  FAILED // thanh toán thất bại
  REFUNDED // dã hoàn tiền

  @@map("payment_status")
}

enum AddressType {
  HOME
  OFFICE

  @@map("address_type")
}

enum CouponType {
  PERCENT
  AMOUNT
  FREE_SHIPPING

  @@map("coupon_type")
}

// --- Models ---

model User {
  id                       String    @id @default(uuid())
  email                    String    @unique
  password                 String?
  firstName                String
  lastName                 String
  phone                    String?
  avatarUrl                String
  role                     UserRole  @default(USER)
  isActive                 Boolean   @default(true)
  googleId                 String?   @unique
  isEmailVerified          Boolean   @default(false)
  emailVerificationToken   String?
  emailVerificationExpires DateTime?
  resetPasswordToken       String?
  resetPasswordExpires     DateTime?
  password_changed_at      DateTime?
  isDeleted                Boolean   @default(false)
  deletedBy                String?
  deletedByUser            User?     @relation("UserDeletedBy", fields: [deletedBy], references: [id])
  deletedUsers             User[]    @relation("UserDeletedBy")
  deletedAt                DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  addresses                Address[]
  cart                     Cart?
  Order                    Order[]
  reviews                  Review[]

  @@index([role])
  @@index([googleId])
  @@index([isActive])
  @@index([isDeleted])
  @@map("users")
}

model Address {
  id              String      @id @default(uuid())
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade) // onDelete: nghĩa là nếu user bị xoá thì các post con liên quan cũng bị xoá.
  userId          String
  nameReminiscent String
  firstName       String
  lastName        String
  phone           String
  address         String
  ward            String
  district        String
  city            String
  fullAddress     String
  isDefault       Boolean     @default(false)
  addressType     AddressType @default(HOME)

  /**
   * Đơn hàng có thể tham chiếu địa chỉ này tại thời điểm tạo (snapshot)
   * Khi người dùng tạo đơn hàng, hệ thống lưu lại địa chỉ tại thời điểm đó
   * Người dùng có địa chỉ “123 Đống Đa, Hà Nội”.
   * Khi tạo đơn hàng, order đó sẽ lưu addressId trỏ về địa chỉ này.
   * Sau này người dùng sửa địa chỉ thành "456 Cầu Giấy", thì đơn hàng cũ vẫn trỏ về địa chỉ ban đầu, không bị đổi.
   */
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isDefault])
  @@map("addresses")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?   @db.Text
  isPublished Boolean   @default(true)
  products    Product[]
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([name])
  @@index([slug])
  @@index([isPublished])
  @@index([isDeleted])
  @@map("categories")
}

model Color {
  id        String           @id @default(uuid())
  name      String           @unique
  hex       String
  isActive  Boolean          @default(true)
  variants  ProductVariant[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("colors")
}

model Size {
  id        String           @id @default(uuid())
  name      String           @unique // "Small", "Medium", "Large"
  value     String           @unique // "s", "m", "l"
  isActive  Boolean          @default(true)
  variants  ProductVariant[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("sizes")
}

model Style {
  id          String         @id @default(uuid())
  name        String         @unique
  slug        String         @unique
  description String?
  isActive    Boolean        @default(true)
  styles      ProductStyle[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([slug])
  @@map("styles")
}

model ProductStyle {
  productId String
  styleId   String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  style     Style   @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@id([productId, styleId]) // 1 product + 1 style chỉ 1 dòng duy nhất
  @@index([styleId])
  @@map("product_styles")
}

model Product {
  id          String           @id @default(uuid())
  name        String
  slug        String           @unique
  description String?
  price       Int
  stock       Int              @default(0)
  isPublished Boolean          @default(false)
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  styles      ProductStyle[]
  variants    ProductVariant[]
  images      ProductImage[] // ảnh chung + ảnh variant (thông qua variantId)
  isDeleted   Boolean          @default(false)
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  reviews     Review[]

  @@index([slug])
  @@index([isPublished])
  @@map("products")
}

model ProductImage {
  id        String          @id @default(uuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String? // nếu variantId = null => ảnh “chung” cho product, ko thì ảnh riêng của variant
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  url       String
  alt       String?
  isMain    Boolean         @default(false)
  sortOrder Int             @default(0)
  deletedAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([productId])
  @@index([variantId])
  @@map("product_images")
}

model ProductVariant {
  id          String         @id @default(uuid())
  productId   String
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorId     String?
  color       Color?         @relation(fields: [colorId], references: [id])
  sizeId      String?
  size        Size?          @relation(fields: [sizeId], references: [id])
  sku         String         @unique
  price       Int // nếu không có giá riêng thì dùng giá chung, nếu có thì ghi đè giá chung
  stock       Int            @default(0)
  isPublished Boolean        @default(true)
  images      ProductImage[] // ảnh riêng cho variant này (nếu có)
  isDeleted   Boolean        @default(false)
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  CartItem    CartItem[]

  @@unique([productId, colorId, sizeId]) // đảm bảo tổ hợp (product + color + size) chỉ có 1 variant
  @@index([productId])
  @@index([colorId])
  @@index([sku])
  @@index([sizeId])
  @@map("product_variants")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
  @@map("carts")
}

model CartItem {
  id        String         @id @default(uuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
  @@map("cart_items")
}

model Order {
  id          String @id @default(uuid())
  orderNumber String @unique
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // shipping address (snapshot at time of order)
  shippingName     String
  shippingPhone    String
  shippingAddress  String
  shippingWard     String
  shippingDistrict String
  shippingCity     String

  // order details
  subtotal    Int
  shippingFee Int
  tax         Int
  discount    Int
  total       Int

  // payment
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  paidAt        DateTime?

  // status
  status OrderStatus @default(PENDING)

  // notes
  notes      String? @db.Text
  adminNotes String? @db.Text

  // Relations
  items OrderItem[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  reviews        Review[]
  coupon         Coupon?  @relation(fields: [couponId], references: [id])
  couponId       String?
  counponCode    String? // snapshot
  couponDiscount Int      @default(0)

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // product snapshot at time of order
  productId   String
  productName String
  productSlug String

  // variant snapshot
  variantId  String
  variantSku String?
  colorName  String?
  colorHex   String?
  sizeName   String?
  sizeValue  String?

  // Image snapshot
  imageUrl String?

  // pricing snapshot
  price    Int
  quantity Int
  subtotal Int // price * quantity

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@map("order_items")
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, orderId, productId]) // 1 review mỗi user mỗi order mỗi product
  @@index([productId])
  @@index([userId])
  @@index([orderId])
  @@index([rating])
  @@map("reviews")
}

model Coupon {
  id             String     @id @default(uuid())
  code           String     @unique
  name           String
  description    String?    @db.Text
  type           CouponType
  value          Int
  minOrderAmount Int?
  maxDiscount    Int?
  usageLimit     Int?
  usageCount     Int        @default(0)
  perUserLimit   Int        @default(1)
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean    @default(true)
  orders         Order[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([code])
  @@index([isActive])
  @@index([startDate, endDate])
  @@map("coupons")
}
